#include <iostream>
#include <string>
using namespace std;

class SinhVien
{
private:
    string hoTen;
    int namSinh;
    float diem[4];

public:
    // Phuong thuc nhap
    void nhap()
    {
        cin.ignore();

        cout << "Nhap ho ten: ";
        getline(cin, hoTen);

        cout << "Nhap nam sinh: ";
        cin >> namSinh;

        for (int i = 0; i < 4; i++)
        {
            cout << "Nhap diem mon " << i + 1 << ": ";
            cin >> diem[i];
        }
    }

    // Phuong thuc tinh diem trung binh
    float tinhDTB()
    {
        float tong = 0;

        for (int i = 0; i < 4; i++)
        {
            tong += diem[i];
        }

        return tong / 4;
    }

    // Phuong thuc xuat
    void xuat()
    {
        cout << "Ho ten: " << hoTen << endl;
        cout << "Nam sinh: " << namSinh << endl;

        for (int i = 0; i < 4; i++)
        {
            cout << "Diem mon " << i + 1 << ": " << diem[i] << endl;
        }

        cout << "Diem trung binh: " << tinhDTB() << endl;
    }

    // Kiem tra co mon nao duoi 5 hay khong
    bool khongCoMonDuoi5()
    {
        for (int i = 0; i < 4; i++)
        {
            if (diem[i] < 5)
            {
                return false;
            }
        }

        return true;
    }

    // Kiem tra dieu kien thi tot nghiep
    bool thiTotNghiep()
    {
        return tinhDTB() < 7 && khongCoMonDuoi5();
    }
};

int main()
{
    int n;

    cout << "Nhap so luong sinh vien: ";
    cin >> n;

    SinhVien ds[100];

    // Nhap danh sach
    for (int i = 0; i < n; i++)
    {
        cout << "\n===== NHAP SINH VIEN " << i + 1 << " =====" << endl;
        ds[i].nhap();
    }

    // In sinh vien phai thi tot nghiep
    cout << "\n\n===== SINH VIEN PHAI THI TOT NGHIEP =====" << endl;

    bool coSinhVien = false;

    for (int i = 0; i < n; i++)
    {
        if (ds[i].thiTotNghiep())
        {
            coSinhVien = true;

            cout << "\n--- Sinh vien " << i + 1 << " ---" << endl;
            ds[i].xuat();
        }
    }

    if (!coSinhVien)
    {
        cout << "Khong co sinh vien nao phai thi tot nghiep." << endl;
    }

    return 0;
}
