#include <iostream>
#include <string>
using namespace std;

class SinhVien
{
private:
    string hoTen;
    int namSinh;
    float diem[5];

public:
    // Phuong thuc nhap
    void nhap()
    {
        cin.ignore();
        cout << "Nhap ho ten: ";
        getline(cin, hoTen);

        cout << "Nhap nam sinh: ";
        cin >> namSinh;

        for (int i = 0; i < 5; i++)
        {
            cout << "Nhap diem mon " << i + 1 << ": ";
            cin >> diem[i];
        }
    }

    // Phuong thuc tinh diem trung binh
    float tinhDTB()
    {
        float tong = 0;

        for (int i = 0; i < 5; i++)
        {
            tong += diem[i];
        }

        return tong / 5;
    }

    // Phuong thuc xuat
    void xuat()
    {
        cout << "Ho ten: " << hoTen << endl;
        cout << "Nam sinh: " << namSinh << endl;

        for (int i = 0; i < 5; i++)
        {
            cout << "Diem mon " << i + 1 << ": " << diem[i] << endl;
        }

        cout << "Diem trung binh: " << tinhDTB() << endl;
    }

    // Kiem tra va in mon phai thi lai
    void thiLai()
    {
        bool coThiLai = false;

        for (int i = 0; i < 5; i++)
        {
            if (diem[i] < 5)
            {
                coThiLai = true;

                cout << "Mon " << i + 1
                     << " - Diem: " << diem[i] << endl;
            }
        }

        if (!coThiLai)
        {
            cout << "Khong co mon nao phai thi lai." << endl;
        }
    }
};

int main()
{
    int n;

    cout << "Nhap so luong sinh vien: ";
    cin >> n;

    SinhVien ds[100];

    // Nhap danh sach sinh vien
    for (int i = 0; i < n; i++)
    {
        cout << "\n===== NHAP SINH VIEN " << i + 1 << " =====" << endl;
        ds[i].nhap();
    }

    // Xuat sinh vien phai thi lai
    cout << "\n\n===== SINH VIEN PHAI THI LAI =====" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << "\n--- Sinh vien " << i + 1 << " ---" << endl;
        ds[i].xuat();

        cout << "Cac mon phai thi lai:" << endl;
        ds[i].thiLai();
    }

    return 0;
}
